---
import Base from '../layouts/Base.astro';
---
<Base>
<canvas id="fx" aria-hidden="true"></canvas>
<div id="progress" aria-hidden="true"></div>

<header class="top">
  <div class="wrap top-in">
    <a class="logo" href="#inicio"><i aria-hidden="true"><b></b><b></b><b></b><b></b><b></b><b></b><b></b><b></b><b></b></i>eduardo toste</a>
    <nav class="nav" aria-label="Seções">
      <a href="#stack" data-t="nav.stack">Stack</a>
      <a href="#projetos" data-t="nav.proj">Projetos</a>
      <a href="#github" data-t="nav.gh">GitHub</a>
      <a href="#trajetoria" data-t="nav.traj">Trajetória</a>
      <a href="#contato" data-t="nav.contact">Contato</a>
    </nav>
    <div class="tools">
      <div class="lang" role="group" aria-label="Idioma">
        <button type="button" data-lang="pt" aria-pressed="true">PT</button>
        <button type="button" data-lang="en" aria-pressed="false">EN</button>
      </div>
    </div>
  </div>
</header>

<main>
  <!-- HERO -->
  <section class="hero" id="inicio">
    <div class="wrap hero-in">
      <div class="hero-top rv" style="--d:0ms">
        <p class="status"><span class="pulse"></span><span>São Paulo</span><em>· <span id="clock">--:--</span></em></p>
        <a class="handle" href="https://github.com/eduardo-toste" target="_blank" rel="noopener">github.com/eduardo-toste</a>
      </div>
      <div class="graph-card rv" style="--d:80ms">
        <div class="graph-head">
          <span id="ghead"><b>—</b> contribuições no último ano</span>
          <span class="legend"><span data-t="graph.less">Menos</span><i style="background:var(--c0)"></i><i style="background:var(--c1)"></i><i style="background:var(--c2)"></i><i style="background:var(--c3)"></i><i style="background:var(--c4)"></i><span data-t="graph.more">Mais</span></span>
        </div>
        <div class="graph slot" data-shape="name" style="border:0;border-radius:0;aspect-ratio:auto;max-height:none;background:none" role="img" aria-label="Eduardo Toste escrito com quadrados do gráfico de contribuições"></div>
        <div class="graph-foot"><span data-t="graph.hint">passe o mouse para commitar · clique para soltar uma onda</span><span data-t="graph.scroll">role para explorar ↓</span></div>
      </div>
      <h1 class="sr">Eduardo Toste</h1>
      <div class="hero-bot">
        <p class="role split" id="role" style="--d:500ms"></p>
        <div class="hero-side">
          <p class="lead rv" style="--d:750ms" data-t="hero.lead">Engenheiro de Software que gosta de pensar o sistema inteiro: arquitetura, APIs, nuvem e qualidade. Hoje exploro como levar IA generativa para produtos e para o próprio jeito de construir software, com LLMs, agentes e automação.</p>
          <div class="ctas rv" style="--d:850ms">
            <a class="btn p" href="#projetos" data-t="hero.cta2">Ver projetos</a>
            <a class="btn g" href="https://github.com/eduardo-toste" target="_blank" rel="noopener">GitHub ↗</a>
          </div>
        </div>
      </div>
      <div class="hstats rv" style="--d:1000ms">
        <div><b data-count="5" data-suffix="+">0</b><span data-t="hs.years">anos de experiência em tecnologia</span></div>
        <div><b id="hs-repos">—</b><span data-t="hs.repos">repositórios públicos no GitHub</span></div>
        <div><b id="hs-commits">—</b><span data-t="hs.commits">contribuições no último ano</span></div>
        <div><b data-count="40" data-suffix="%">0</b><span data-t="hs.effort">menos esforço para criar testes no framework que projetei</span></div>
      </div>
    </div>
  </section>

  <div class="ticker" aria-hidden="true"><div class="ticker-track" id="ticker"></div></div>

  <!-- STACK -->
  <section class="sec" id="stack">
    <div class="wrap sec-in">
      <div><div class="slot-wrap rv">
        <div class="slot" data-shape="layers" aria-hidden="true"></div>
        <div class="commit-card"><div class="ch"><b>a3f9c21</b><span>01 / 05</span></div><div class="cm"><em>feat(stack):</em> <span data-t="cm.stack">software, cloud e IA</span></div></div>
      </div></div>
      <div class="content">
        <div class="sec-head">
          <p class="kicker">01 / stack <span class="commits"></span></p>
          <h2 class="split" data-t="stack.title">Com o que eu trabalho</h2>
          <p class="lead rv" style="--d:200ms" data-t="stack.lead">Engenharia de software de ponta a ponta: arquitetura, APIs, dados, nuvem e testes, com IA entrando cada vez mais no meio do caminho.</p>
        </div>
        <div class="stack-grid" id="stack-grid"></div>
      </div>
    </div>
  </section>

  <!-- PROJETOS -->
  <section class="sec" id="projetos">
    <div class="wrap sec-in">
      <div><div class="slot-wrap rv">
        <div class="slot" data-shape="browser" aria-hidden="true"></div>
        <div class="commit-card"><div class="ch"><b>7c02e8d</b><span>02 / 05</span></div><div class="cm"><em>feat(projects):</em> <span data-t="cm.proj">3 projetos em destaque</span></div></div>
      </div></div>
      <div class="content">
        <div class="sec-head">
          <p class="kicker"><span>02 / <span data-t="nav.projl">projetos</span></span> <span class="commits"></span></p>
          <h2 class="split" data-t="proj.title">Coisas que eu construí</h2>
        </div>
        <div class="proj rv" style="--d:150ms">
          <div class="ptabs" role="tablist" aria-label="Projetos" id="ptabs"></div>
          <div class="card pdetail" role="tabpanel" id="pdetail" tabindex="0"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- GITHUB -->
  <section class="sec" id="github">
    <div class="wrap sec-in">
      <div><div class="slot-wrap rv">
        <div class="slot" data-shape="bars" aria-hidden="true"></div>
        <div class="commit-card"><div class="ch"><b>e41b9aa</b><span>03 / 05</span></div><div class="cm"><em>chore(github):</em> <span id="cm-gh">sincronizado com o GitHub</span></div></div>
      </div></div>
      <div class="content">
        <div class="sec-head">
          <p class="kicker">03 / github <span class="commits"></span></p>
          <h2 class="split" data-t="gh.title">Atividade no GitHub</h2>
          <span class="tag rv" id="gh-src" aria-live="polite">carregando dados do GitHub…</span>
        </div>
        <div class="ghtop rv" style="--d:120ms">
          <div class="ghtotal"><b id="gh-total">—</b><span data-t="gh.total">contribuições no último ano</span></div>
          <div class="ghstats">
            <div><b id="gh-days">—</b><span data-t="gh.days">dias ativos</span></div>
            <div><b id="gh-streak">—</b><span data-t="gh.streak">sequência atual</span></div>
            <div><b id="gh-best">—</b><span data-t="gh.best">maior sequência</span></div>
            <div><b id="gh-top">—</b><span id="gh-top-l">melhor dia</span></div>
          </div>
        </div>
        <div class="card heat-wrap rv" style="--d:220ms"><div class="heat" id="heat" role="img" aria-label="Mapa de contribuições do último ano"></div><div class="heat-foot"><span id="gh-year"></span><span data-t="gh.today">hoje ▢</span></div></div>
        <div class="repos-wrap rv" style="--d:300ms" id="repos-wrap" hidden>
          <div class="repos-head"><p class="sublabel" data-t="gh.repos">repositórios atualizados recentemente</p><a href="https://github.com/eduardo-toste?tab=repositories" target="_blank" rel="noopener" data-t="gh.all">Ver todos no GitHub ↗</a></div>
          <div class="repos" id="repos"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRAJETÓRIA -->
  <section class="sec" id="trajetoria">
    <div class="wrap sec-in">
      <div><div class="slot-wrap rv">
        <div class="slot" data-shape="branch" aria-hidden="true"></div>
        <div class="commit-card"><div class="ch"><b>HEAD</b><span>04 / 05</span></div><div class="cm"><em>merge:</em> <span data-t="cm.traj">experiência + formação</span></div></div>
      </div></div>
      <div class="content">
        <div class="sec-head">
          <p class="kicker"><span>04 / <span data-t="nav.trajl">trajetória</span></span> <span class="commits"></span></p>
          <h2 class="split" data-t="traj.title">Experiência e formação</h2>
        </div>
        <div class="card rv" style="--d:150ms"><div class="tl" id="tl"></div></div>
      </div>
    </div>
  </section>

  <!-- CONTATO -->
  <section class="sec" id="contato">
    <div class="wrap sec-in">
      <div><div class="slot-wrap rv">
        <div class="slot" data-shape="mail" aria-hidden="true"></div>
        <div class="commit-card"><div class="ch"><b>f00d42e</b><span>05 / 05</span></div><div class="cm"><em>feat(contact):</em> <span data-t="cm.contact">aguardando seu merge</span></div></div>
      </div></div>
      <div class="content">
        <div class="sec-head">
          <p class="kicker"><span>05 / <span data-t="nav.contactl">contato</span></span> <span class="commits"></span></p>
          <h2 class="split" data-t="contact.title">Vamos conversar?</h2>
          <p class="lead rv" style="--d:200ms" data-t="contact.lead">Quer falar sobre backend, Java ou algum projeto? Me chame no LinkedIn. Falo inglês em nível avançado (C1).</p>
        </div>
        <div class="cgrid">
          <a class="rv" style="--d:300ms" href="https://github.com/eduardo-toste" target="_blank" rel="noopener"><b>GitHub ↗</b><span>@eduardo-toste</span></a>
          <a class="rv" style="--d:380ms" href="https://www.linkedin.com/in/eduardo-toste" target="_blank" rel="noopener"><b>LinkedIn ↗</b><span>/in/eduardo-toste</span></a>
        </div>
      </div>
    </div>
  </section>
</main>

<footer><div class="wrap"><span>© 2026 Eduardo Toste</span><span data-t="footer">Feito com Astro e muitos commits.</span></div></footer>
</Base>

<script>
  import '../scripts/main.js';
</script>
